# Required
DATABASE_URL=""                 # Neon Postgres connection string (pooled)
IP_HASH_SALT=""                 # random string; IPs are salted + hashed, never stored raw
NEXT_PUBLIC_SITE_URL="https://bootsoc.com"

# Sanity CMS (articles, jobs, case studies). Site falls back to built-in articles when unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"

# Email notifications for new submissions: set ONE of these
RESEND_API_KEY=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="sayhi@bootsoc.com"
# SMTP_PASS=""                  # app password
NOTIFY_TO="sayhi@bootsoc.com"
NOTIFY_FROM="BootSoc Website <website@bootsoc.com>"

# Optional: analytics & ads (load only with consent)
NEXT_PUBLIC_GA_ID=""            # G-XXXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""

# Optional: Cloudflare Turnstile bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
